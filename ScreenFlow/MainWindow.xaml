<Window x:Class="ScreenFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ScreenFlow" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ScreenFlow" Width="1480" Height="940" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Icon><StaticResource ResourceKey="AppLogo"/></Window.Icon>
 <Window.Resources>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
   <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
  <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window"/>
  <Button x:Name="MaximizeWindowButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeWindow_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize window"/>
  <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close window"/>
 </StackPanel>
 <Grid Margin="0,32,0,0"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="22,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource AppLogo}" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="ScreenFlow mouse-circle logo"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ScreenFlow" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Desktop automation" Style="{StaticResource SecondaryText}"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel x:Name="FileButtons" Orientation="Horizontal">
      <Button Click="New_Click" ToolTip="New workflow" AutomationProperties.Name="New workflow" Margin="0,0,6,0"><local:IconLabel Glyph="&#xE710;" Label="New"/></Button>
      <Button Click="Open_Click" ToolTip="Open workflow" AutomationProperties.Name="Open workflow" Margin="0,0,6,0"><local:IconLabel Glyph="&#xE8E5;" Label="Open"/></Button>
      <Button Click="Save_Click" ToolTip="Save workflow" AutomationProperties.Name="Save workflow" Margin="0,0,6,0"><local:IconLabel Glyph="&#xE74E;" Label="Save"/></Button>
      <Button Click="SaveAs_Click" ToolTip="Save workflow as" AutomationProperties.Name="Save workflow as" Margin="0,0,6,0"><local:IconLabel Glyph="&#xE792;" Label="Save as"/></Button>
     </StackPanel>
     <Border Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,3,14,3"/>
     <Button x:Name="RunButton" Style="{DynamicResource AccentButtonStyle}" Click="Run_Click" AutomationProperties.Name="Run workflow" Margin="0,0,6,0"><local:IconLabel Glyph="&#xE768;" Label="Run workflow"/></Button>
     <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False" AutomationProperties.Name="Stop workflow" ToolTip="Stop workflow (F8)" Margin="0,0,16,0"><local:IconLabel Glyph="&#xE71A;" Label="Stop · F8"/></Button>
     <ComboBox x:Name="ThemePicker" Width="145" SelectedValuePath="Tag" SelectionChanged="Theme_Changed" AutomationProperties.Name="Appearance theme" ToolTip="Appearance"><ComboBoxItem Tag="System"><local:IconLabel Glyph="&#xE770;" Label="System"/></ComboBoxItem><ComboBoxItem Tag="Light"><local:IconLabel Glyph="&#xE706;" Label="Light"/></ComboBoxItem><ComboBoxItem Tag="Dark"><local:IconLabel Glyph="&#xE708;" Label="Dark"/></ComboBoxItem></ComboBox>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="344"/></Grid.ColumnDefinitions>
   <DockPanel Margin="14,22,10,16">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,12"><TextBlock Text="Actions" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Select an action to add it" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/><Grid Margin="0,12,4,0"><TextBox x:Name="ActionSearch" TextChanged="ActionSearch_Changed" AutomationProperties.Name="Search actions" ToolTip="Search actions"/><TextBlock x:Name="SearchHint" Text="Search actions" Style="{StaticResource SecondaryText}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/></Grid></StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,4,0"><StackPanel><local:IconLabel Glyph="&#xE946;" Label="Mouse and keyboard"/><TextBlock Text="Runs locally using real input and visual targets." TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/></StackPanel></Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ActionLibrary"/></ScrollViewer>
   </DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource LayerFillColorAltBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="4,12,12,12">
    <Grid Margin="22,20,22,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Workflow" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="DirtyLabel" Text="  •  Unsaved changes" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12"/></StackPanel><TextBox x:Name="WorkflowName" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,5" TextChanged="WorkflowName_Changed"/><TextBlock Text="Arrange actions, choose targets, then run." Style="{StaticResource SecondaryText}" Margin="0,5,0,16"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StepCount" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="MoveUpButton" IsEnabled="False" Click="Up_Click" ToolTip="Move action up" AutomationProperties.Name="Move action up" Margin="0,0,5,0"><local:IconLabel Glyph="&#xE70E;"/></Button><Button x:Name="MoveDownButton" IsEnabled="False" Click="Down_Click" ToolTip="Move action down" AutomationProperties.Name="Move action down" Margin="0,0,5,0"><local:IconLabel Glyph="&#xE70D;"/></Button><Button x:Name="DuplicateButton" IsEnabled="False" Click="Duplicate_Click" ToolTip="Duplicate action" AutomationProperties.Name="Duplicate action" Margin="0,0,5,0"><local:IconLabel Glyph="&#xE8C8;" Label="Duplicate"/></Button><Button x:Name="RemoveButton" IsEnabled="False" Click="Remove_Click" ToolTip="Remove action" AutomationProperties.Name="Remove action"><local:IconLabel Glyph="&#xE74D;" Label="Remove"/></Button></StackPanel>
     </Grid>
     <Grid Grid.Row="2"><ListBox x:Name="StepsList" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="Steps_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AlternationCount="100000" SelectionMode="Single">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="{Binding Indent}"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource StepNumber}}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="3,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" ToolTip="Enable action" AutomationProperties.Name="Enable action" Click="Enabled_Changed" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="Create your first workflow" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock Text="Choose an action from the left to get started." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/></StackPanel></Grid>
     <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button Click="ClearLog_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" AutomationProperties.Name="Clear activity log" ToolTip="Clear activity log"><local:IconLabel Glyph="&#xE711;" Label="Clear"/></Button><TextBlock Text="Run activity" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/></DockPanel><TextBox Grid.Row="1" x:Name="RunLog" IsReadOnly="True" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid>
    </Grid>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,12,12"><StackPanel Margin="8,10,12,16">
    <TextBlock Text="Action settings" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="EditorTitle" Text="Choose an action" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock x:Name="EditorHint" Text="Select a workflow step to customize it." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel x:Name="EditorFields"/><TextBlock x:Name="EditorError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
    <Button x:Name="ApplyButton" Style="{DynamicResource AccentButtonStyle}" Click="Apply_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,13,0,0" Visibility="Collapsed" AutomationProperties.Name="Apply changes"><local:IconLabel Glyph="&#xE73E;" Label="Apply changes"/></Button>
    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,24,0,20"/><TextBlock Text="Run settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Repeat cycles" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><TextBox x:Name="RepeatInput" Text="1" TextChanged="Settings_Changed"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Start delay (sec)" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/><TextBox x:Name="CountdownInput" Text="3" TextChanged="Settings_Changed"/></StackPanel></Grid>
    <CheckBox x:Name="MinimizeOnRun" Content="Minimize when running" IsChecked="True" Margin="0,15,0,10"/><TextBlock Text="Focus your target app during the countdown. Press F8 anywhere to stop." Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
    <TextBlock Text="Get started" Style="{StaticResource SectionLabel}" Margin="0,22,0,10"/>
    <Button Click="NewTabExample_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Load new browser tab example"><local:IconLabel Glyph="&#xE8A7;" Label="New browser tab example"/></Button><Button Click="Example_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Load URL handoff example"><local:IconLabel Glyph="&#xE71B;" Label="URL handoff example"/></Button><Button Click="Practice_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Open practice window"><local:IconLabel Glyph="&#xE7C4;" Label="Open practice window"/></Button>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="22,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Ready to build" Style="{StaticResource SecondaryText}"/></StackPanel><TextBlock x:Name="HotkeyStatus" Text="Local execution  ·  OpenCV vision  ·  F8 emergency stop" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/></Grid></Border>
 </Grid>
 </Grid>
</Window>
